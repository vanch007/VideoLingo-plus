[
  {
    "id": "seg_0001",
    "start": 3.11,
    "end": 4.35,
    "speaker": "S01",
    "text": "胡万"
  },
  {
    "id": "seg_0002",
    "start": 5.35,
    "end": 6.01,
    "speaker": "S02",
    "text": "胡万"
  },
  {
    "id": "seg_0003",
    "start": 6.52,
    "end": 7.55,
    "speaker": "S01",
    "text": "怎么会是胡万"
  },
  {
    "id": "seg_0004",
    "start": 8.52,
    "end": 9.05,
    "speaker": "S03",
    "text": "嘿"
  },
  {
    "id": "seg_0005",
    "start": 9.46,
    "end": 9.99,
    "speaker": "S03",
    "text": "坏了"
  },
  {
    "id": "seg_0006",
    "start": 11.56,
    "end": 12.1,
    "speaker": "S04",
    "text": "四筒"
  },
  {
    "id": "seg_0007",
    "start": 12.13,
    "end": 13.39,
    "speaker": "S01",
    "text": "全是黄家的人"
  },
  {
    "id": "seg_0008",
    "start": 13.42,
    "end": 15.83,
    "speaker": "S01",
    "text": "马匪呢"
  },
  {
    "id": "seg_0009",
    "start": 15.86,
    "end": 18.17,
    "speaker": "S05",
    "text": "胡万就是马匪"
  },
  {
    "id": "seg_0010",
    "start": 18.42,
    "end": 20.73,
    "speaker": "S05",
    "text": "马匪就是胡万"
  },
  {
    "id": "seg_0011",
    "start": 21.34,
    "end": 24.75,
    "speaker": "S05",
    "text": "他县长夫人绑架豪绅"
  },
  {
    "id": "seg_0012",
    "start": 25.0,
    "end": 27.04,
    "speaker": "S05",
    "text": "祸害鹅城百姓"
  },
  {
    "id": "seg_0013",
    "start": 27.45,
    "end": 30.36,
    "speaker": "S05",
    "text": "就是你黄老爷家的胡万"
  },
  {
    "id": "seg_0014",
    "start": 30.97,
    "end": 33.78,
    "speaker": "S05",
    "text": "我说你为什么不出钱剿匪"
  },
  {
    "id": "seg_0015",
    "start": 33.99,
    "end": 36.8,
    "speaker": "S05",
    "text": "原来你是贼喊捉贼呀"
  },
  {
    "id": "seg_0016",
    "start": 38.41,
    "end": 41.92,
    "speaker": "S05",
    "text": "你拿枪指着我"
  },
  {
    "id": "seg_0017",
    "start": 43.73,
    "end": 45.37,
    "speaker": "S05",
    "text": "你想跟我火拼"
  },
  {
    "id": "seg_0018",
    "start": 50.28,
    "end": 51.56,
    "speaker": "S01",
    "text": "你们看到了没有"
  },
  {
    "id": "seg_0019",
    "start": 51.69,
    "end": 53.88,
    "speaker": "S01",
    "text": "这就是当马匪的下场"
  },
  {
    "id": "seg_0020",
    "start": 54.13,
    "end": 56.64,
    "speaker": "S01",
    "text": "就算是我亲爹也得死"
  },
  {
    "id": "seg_0021",
    "start": 57.15,
    "end": 58.28,
    "speaker": "S01",
    "text": "死有余辜"
  },
  {
    "id": "seg_0022",
    "start": 59.69,
    "end": 60.22,
    "speaker": "S01",
    "text": "走"
  },
  {
    "id": "seg_0023",
    "start": 64.93,
    "end": 68.77,
    "speaker": "S05",
    "text": "马匪胡万又让黄老爷枪毙了五回"
  },
  {
    "id": "seg_0024",
    "start": 69.02,
    "end": 69.88,
    "speaker": "S05",
    "text": "大义灭亲"
  },
  {
    "id": "seg_0025",
    "start": 70.39,
    "end": 71.67,
    "speaker": "S05",
    "text": "杀人灭口"
  },
  {
    "id": "seg_0026",
    "start": 72.19,
    "end": 73.47,
    "speaker": "S05",
    "text": "杀人灭口"
  },
  {
    "id": "seg_0027",
    "start": 73.72,
    "end": 75.51,
    "speaker": "S05",
    "text": "你就是马匪的头子"
  },
  {
    "id": "seg_0028",
    "start": 75.77,
    "end": 76.54,
    "speaker": "S05",
    "text": "张麻子"
  },
  {
    "id": "seg_0029",
    "start": 77.82,
    "end": 78.84,
    "speaker": "S05",
    "text": "大义灭亲"
  },
  {
    "id": "seg_0030",
    "start": 79.55,
    "end": 80.08,
    "speaker": "S05",
    "text": "那好"
  },
  {
    "id": "seg_0031",
    "start": 81.05,
    "end": 81.82,
    "speaker": "S05",
    "text": "你出钱"
  },
  {
    "id": "seg_0032",
    "start": 81.85,
    "end": 82.38,
    "speaker": "S05",
    "text": "我剿匪"
  },
  {
    "id": "seg_0033",
    "start": 82.79,
    "end": 83.56,
    "speaker": "S01",
    "text": "好啊"
  },
  {
    "id": "seg_0034",
    "start": 84.47,
    "end": 85.24,
    "speaker": "S01",
    "text": "三天之后"
  },
  {
    "id": "seg_0035",
    "start": 86.15,
    "end": 87.43,
    "speaker": "S01",
    "text": "一定给县长"
  },
  {
    "id": "seg_0036",
    "start": 88.24,
    "end": 88.91,
    "speaker": "S01",
    "text": "一个惊喜"
  },
  {
    "id": "seg_0037",
    "start": 89.72,
    "end": 90.25,
    "speaker": "S05",
    "text": "汤师爷"
  },
  {
    "id": "seg_0038",
    "start": 90.96,
    "end": 92.49,
    "speaker": "S05",
    "text": "他是胡万的恩人"
  },
  {
    "id": "seg_0039",
    "start": 92.9,
    "end": 94.7,
    "speaker": "S05",
    "text": "现在又成了你的恩人"
  },
  {
    "id": "seg_0040",
    "start": 95.41,
    "end": 96.44,
    "speaker": "S05",
    "text": "你给翻译翻译"
  },
  {
    "id": "seg_0041",
    "start": 97.47,
    "end": 98.5,
    "speaker": "S05",
    "text": "什么叫惊喜"
  },
  {
    "id": "seg_0042",
    "start": 99.53,
    "end": 101.84,
    "speaker": "S05",
    "text": "翻译翻译什么叫惊喜"
  },
  {
    "id": "seg_0043",
    "start": 101.87,
    "end": 102.89,
    "speaker": "S02",
    "text": "这还用翻译"
  },
  {
    "id": "seg_0044",
    "start": 102.92,
    "end": 104.56,
    "speaker": "S05",
    "text": "我让你翻译给我听"
  },
  {
    "id": "seg_0045",
    "start": 104.59,
    "end": 106.53,
    "speaker": "S05",
    "text": "什么叫惊喜"
  },
  {
    "id": "seg_0046",
    "start": 106.56,
    "end": 107.84,
    "speaker": "S02",
    "text": "不用翻译就是惊喜"
  },
  {
    "id": "seg_0047",
    "start": 107.87,
    "end": 109.15,
    "speaker": "S06",
    "text": "难道你听不懂什么叫惊喜"
  },
  {
    "id": "seg_0048",
    "start": 109.18,
    "end": 110.46,
    "speaker": "S05",
    "text": "我就想让你翻译翻译"
  },
  {
    "id": "seg_0049",
    "start": 110.49,
    "end": 112.28,
    "speaker": "S05",
    "text": "什么叫惊喜"
  },
  {
    "id": "seg_0050",
    "start": 112.31,
    "end": 112.97,
    "speaker": "S02",
    "text": "惊喜"
  },
  {
    "id": "seg_0051",
    "start": 113.0,
    "end": 114.38,
    "speaker": "S05",
    "text": "翻译出来给我听"
  },
  {
    "id": "seg_0052",
    "start": 114.41,
    "end": 117.07,
    "speaker": "S05",
    "text": "什么他妈的叫惊喜"
  },
  {
    "id": "seg_0053",
    "start": 117.1,
    "end": 117.41,
    "speaker": "S02",
    "text": "什么"
  },
  {
    "id": "seg_0054",
    "start": 117.44,
    "end": 119.23,
    "speaker": "S05",
    "text": "什么他妈的叫"
  },
  {
    "id": "seg_0055",
    "start": 119.48,
    "end": 121.27,
    "speaker": "S05",
    "text": "他妈的惊喜"
  },
  {
    "id": "seg_0056",
    "start": 121.3,
    "end": 123.21,
    "speaker": "S05",
    "text": "什么他妈的叫惊喜啊"
  },
  {
    "id": "seg_0057",
    "start": 123.34,
    "end": 126.41,
    "speaker": "S01",
    "text": "惊喜就是三天之后我出一百八十万"
  },
  {
    "id": "seg_0058",
    "start": 126.62,
    "end": 127.9,
    "speaker": "S01",
    "text": "给你们出城剿匪"
  },
  {
    "id": "seg_0059",
    "start": 128.41,
    "end": 129.28,
    "speaker": "S01",
    "text": "接上他的腿"
  },
  {
    "id": "seg_0060",
    "start": 129.79,
    "end": 130.32,
    "speaker": "S01",
    "text": "明白了吗"
  },
  {
    "id": "seg_0061",
    "start": 130.83,
    "end": 131.86,
    "speaker": "S02",
    "text": "这就是惊喜啊"
  },
  {
    "id": "seg_0062",
    "start": 132.47,
    "end": 133.0,
    "speaker": "S05",
    "text": "翻译翻译"
  },
  {
    "id": "seg_0063",
    "start": 137.41,
    "end": 138.17,
    "speaker": "S05",
    "text": "翻译翻译"
  },
  {
    "id": "seg_0064",
    "start": 138.21,
    "end": 140.12,
    "speaker": "S02",
    "text": "惊喜就是三天之后"
  },
  {
    "id": "seg_0065",
    "start": 140.15,
    "end": 142.28,
    "speaker": "S02",
    "text": "给你一百八十万两银子"
  },
  {
    "id": "seg_0066",
    "start": 142.31,
    "end": 143.69,
    "speaker": "S02",
    "text": "出城剿匪"
  },
  {
    "id": "seg_0067",
    "start": 143.82,
    "end": 144.95,
    "speaker": "S02",
    "text": "接上他的腿"
  },
  {
    "id": "seg_0068",
    "start": 146.86,
    "end": 148.39,
    "speaker": "S05",
    "text": "大哥这他妈是惊喜啊"
  },
  {
    "id": "seg_0069",
    "start": 148.7,
    "end": 150.34,
    "speaker": "S05",
    "text": "小弟我愿意等你三天"
  },
  {
    "id": "seg_0070",
    "start": 150.37,
    "end": 150.88,
    "speaker": "S01",
    "text": "好"
  },
  {
    "id": "seg_0071",
    "start": 153.98,
    "end": 154.75,
    "speaker": "S05",
    "text": "黄老爷"
  },
  {
    "id": "seg_0072",
    "start": 155.26,
    "end": 157.77,
    "speaker": "S05",
    "text": "汤师爷是我的挚爱"
  },
  {
    "id": "seg_0073",
    "start": 158.38,
    "end": 160.99,
    "speaker": "S05",
    "text": "你可不能夺我所爱啊"
  },
  {
    "id": "seg_0074",
    "start": 162.1,
    "end": 163.74,
    "speaker": "S01",
    "text": "了然"
  },
  {
    "id": "seg_0075",
    "start": 167.92,
    "end": 168.68,
    "speaker": "S07",
    "text": "到底是谁"
  },
  {
    "id": "seg_0076",
    "start": 168.94,
    "end": 169.47,
    "speaker": "S07",
    "text": "这个"
  },
  {
    "id": "seg_0077",
    "start": 169.98,
    "end": 170.75,
    "speaker": "S07",
    "text": "你这"
  }
]
