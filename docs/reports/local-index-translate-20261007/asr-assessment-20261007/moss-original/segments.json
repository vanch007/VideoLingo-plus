[
  {
    "id": "seg_0001",
    "start": 3.11,
    "end": 4.32,
    "speaker": "S01",
    "text": "胡万"
  },
  {
    "id": "seg_0002",
    "start": 4.92,
    "end": 5.95,
    "speaker": "S02",
    "text": "胡万"
  },
  {
    "id": "seg_0003",
    "start": 6.52,
    "end": 7.55,
    "speaker": "S01",
    "text": "怎么会是胡万"
  },
  {
    "id": "seg_0004",
    "start": 8.52,
    "end": 9.05,
    "speaker": "S02",
    "text": "嘿"
  },
  {
    "id": "seg_0005",
    "start": 9.42,
    "end": 9.95,
    "speaker": "S02",
    "text": "坏了"
  },
  {
    "id": "seg_0006",
    "start": 11.55,
    "end": 12.18,
    "speaker": "S02",
    "text": "刺头吗"
  },
  {
    "id": "seg_0007",
    "start": 12.22,
    "end": 13.42,
    "speaker": "S01",
    "text": "俺是黄家的人"
  },
  {
    "id": "seg_0008",
    "start": 13.45,
    "end": 15.42,
    "speaker": "S01",
    "text": "马匪呢"
  },
  {
    "id": "seg_0009",
    "start": 15.45,
    "end": 15.98,
    "speaker": "S03",
    "text": "马匪呢"
  },
  {
    "id": "seg_0010",
    "start": 16.02,
    "end": 18.18,
    "speaker": "S04",
    "text": "胡万就是马匪"
  },
  {
    "id": "seg_0011",
    "start": 18.42,
    "end": 20.75,
    "speaker": "S04",
    "text": "马匪就是胡万"
  },
  {
    "id": "seg_0012",
    "start": 21.35,
    "end": 24.72,
    "speaker": "S04",
    "text": "他县长夫人绑架豪绅"
  },
  {
    "id": "seg_0013",
    "start": 25.02,
    "end": 27.05,
    "speaker": "S04",
    "text": "祸害河城百姓"
  },
  {
    "id": "seg_0014",
    "start": 27.42,
    "end": 30.42,
    "speaker": "S04",
    "text": "就是你黄老爷家的胡万"
  },
  {
    "id": "seg_0015",
    "start": 30.95,
    "end": 33.72,
    "speaker": "S04",
    "text": "我说你为什么不出钱剿匪"
  },
  {
    "id": "seg_0016",
    "start": 33.95,
    "end": 36.82,
    "speaker": "S04",
    "text": "原来你是贼喊捉贼呀"
  },
  {
    "id": "seg_0017",
    "start": 38.42,
    "end": 41.95,
    "speaker": "S04",
    "text": "你拿枪指着我"
  },
  {
    "id": "seg_0018",
    "start": 43.72,
    "end": 45.35,
    "speaker": "S04",
    "text": "你想跟我火拼"
  },
  {
    "id": "seg_0019",
    "start": 50.22,
    "end": 51.45,
    "speaker": "S01",
    "text": "你们看到了没有"
  },
  {
    "id": "seg_0020",
    "start": 51.68,
    "end": 53.85,
    "speaker": "S01",
    "text": "这就是当马匪的下场"
  },
  {
    "id": "seg_0021",
    "start": 54.12,
    "end": 56.62,
    "speaker": "S01",
    "text": "就算是我亲爹也得死"
  },
  {
    "id": "seg_0022",
    "start": 57.12,
    "end": 58.25,
    "speaker": "S01",
    "text": "死有余辜"
  },
  {
    "id": "seg_0023",
    "start": 59.68,
    "end": 60.25,
    "speaker": "S01",
    "text": "走"
  },
  {
    "id": "seg_0024",
    "start": 64.92,
    "end": 68.72,
    "speaker": "S04",
    "text": "马匪胡万又让黄老爷枪毙了五回"
  },
  {
    "id": "seg_0025",
    "start": 69.02,
    "end": 69.95,
    "speaker": "S04",
    "text": "大义灭亲"
  },
  {
    "id": "seg_0026",
    "start": 70.32,
    "end": 71.68,
    "speaker": "S04",
    "text": "杀人灭口"
  },
  {
    "id": "seg_0027",
    "start": 72.12,
    "end": 73.45,
    "speaker": "S04",
    "text": "杀人灭口"
  },
  {
    "id": "seg_0028",
    "start": 73.72,
    "end": 75.52,
    "speaker": "S04",
    "text": "你就是马匪的头子"
  },
  {
    "id": "seg_0029",
    "start": 75.75,
    "end": 76.52,
    "speaker": "S04",
    "text": "张麻子"
  },
  {
    "id": "seg_0030",
    "start": 77.52,
    "end": 78.88,
    "speaker": "S04",
    "text": "要是大义灭亲"
  },
  {
    "id": "seg_0031",
    "start": 79.48,
    "end": 80.12,
    "speaker": "S04",
    "text": "那好吧"
  },
  {
    "id": "seg_0032",
    "start": 81.02,
    "end": 81.72,
    "speaker": "S04",
    "text": "你出钱"
  },
  {
    "id": "seg_0033",
    "start": 81.82,
    "end": 82.35,
    "speaker": "S04",
    "text": "我剿匪"
  },
  {
    "id": "seg_0034",
    "start": 82.75,
    "end": 83.42,
    "speaker": "S01",
    "text": "好啊"
  },
  {
    "id": "seg_0035",
    "start": 84.45,
    "end": 85.32,
    "speaker": "S01",
    "text": "三天之后"
  },
  {
    "id": "seg_0036",
    "start": 86.12,
    "end": 87.48,
    "speaker": "S01",
    "text": "一定给县长"
  },
  {
    "id": "seg_0037",
    "start": 88.22,
    "end": 88.95,
    "speaker": "S01",
    "text": "一个惊喜"
  },
  {
    "id": "seg_0038",
    "start": 89.72,
    "end": 90.25,
    "speaker": "S04",
    "text": "汤师爷"
  },
  {
    "id": "seg_0039",
    "start": 90.92,
    "end": 92.45,
    "speaker": "S04",
    "text": "他是胡万的恩人"
  },
  {
    "id": "seg_0040",
    "start": 92.95,
    "end": 94.72,
    "speaker": "S04",
    "text": "现在又成了你的恩人"
  },
  {
    "id": "seg_0041",
    "start": 95.45,
    "end": 96.42,
    "speaker": "S04",
    "text": "你给翻译翻译"
  },
  {
    "id": "seg_0042",
    "start": 97.48,
    "end": 98.52,
    "speaker": "S04",
    "text": "什么叫惊喜"
  },
  {
    "id": "seg_0043",
    "start": 99.52,
    "end": 101.75,
    "speaker": "S04",
    "text": "翻译翻译什么叫惊喜"
  },
  {
    "id": "seg_0044",
    "start": 101.88,
    "end": 102.92,
    "speaker": "S02",
    "text": "这还用翻译"
  },
  {
    "id": "seg_0045",
    "start": 102.95,
    "end": 104.55,
    "speaker": "S04",
    "text": "我让你翻译给我听"
  },
  {
    "id": "seg_0046",
    "start": 104.62,
    "end": 106.55,
    "speaker": "S04",
    "text": "什么叫惊喜"
  },
  {
    "id": "seg_0047",
    "start": 106.58,
    "end": 107.88,
    "speaker": "S02",
    "text": "不用翻译就是惊喜"
  },
  {
    "id": "seg_0048",
    "start": 107.92,
    "end": 109.22,
    "speaker": "S05",
    "text": "难道你听不懂什么叫惊喜"
  },
  {
    "id": "seg_0049",
    "start": 109.25,
    "end": 110.42,
    "speaker": "S04",
    "text": "我就想让你翻译翻译"
  },
  {
    "id": "seg_0050",
    "start": 110.45,
    "end": 112.22,
    "speaker": "S04",
    "text": "什么叫惊喜"
  },
  {
    "id": "seg_0051",
    "start": 112.25,
    "end": 113.12,
    "speaker": "S02",
    "text": "惊喜嘛"
  },
  {
    "id": "seg_0052",
    "start": 113.15,
    "end": 114.32,
    "speaker": "S04",
    "text": "翻译出来给我听"
  },
  {
    "id": "seg_0053",
    "start": 114.52,
    "end": 117.05,
    "speaker": "S04",
    "text": "什么他妈的叫惊喜"
  },
  {
    "id": "seg_0054",
    "start": 117.08,
    "end": 117.42,
    "speaker": "S02",
    "text": "什么"
  },
  {
    "id": "seg_0055",
    "start": 117.45,
    "end": 119.28,
    "speaker": "S04",
    "text": "什么他妈的叫"
  },
  {
    "id": "seg_0056",
    "start": 119.48,
    "end": 121.25,
    "speaker": "S04",
    "text": "他妈的惊喜"
  },
  {
    "id": "seg_0057",
    "start": 121.28,
    "end": 123.25,
    "speaker": "S02",
    "text": "什么他妈的叫惊喜啊"
  },
  {
    "id": "seg_0058",
    "start": 123.32,
    "end": 126.35,
    "speaker": "S01",
    "text": "惊喜就是三天之后我出一百八十万"
  },
  {
    "id": "seg_0059",
    "start": 126.58,
    "end": 127.95,
    "speaker": "S01",
    "text": "给你们出城剿匪"
  },
  {
    "id": "seg_0060",
    "start": 128.38,
    "end": 129.28,
    "speaker": "S01",
    "text": "接上他的腿"
  },
  {
    "id": "seg_0061",
    "start": 129.75,
    "end": 130.32,
    "speaker": "S01",
    "text": "明白了吗"
  },
  {
    "id": "seg_0062",
    "start": 130.82,
    "end": 131.88,
    "speaker": "S02",
    "text": "这就是惊喜啊"
  },
  {
    "id": "seg_0063",
    "start": 132.42,
    "end": 133.05,
    "speaker": "S04",
    "text": "翻译翻译"
  },
  {
    "id": "seg_0064",
    "start": 137.42,
    "end": 138.18,
    "speaker": "S04",
    "text": "翻译翻译"
  },
  {
    "id": "seg_0065",
    "start": 138.22,
    "end": 140.18,
    "speaker": "S02",
    "text": "惊喜就是三天之后"
  },
  {
    "id": "seg_0066",
    "start": 140.22,
    "end": 142.25,
    "speaker": "S02",
    "text": "给你一百八十万两银子"
  },
  {
    "id": "seg_0067",
    "start": 142.32,
    "end": 143.62,
    "speaker": "S02",
    "text": "出城剿匪"
  },
  {
    "id": "seg_0068",
    "start": 143.85,
    "end": 144.95,
    "speaker": "S02",
    "text": "接上他的腿"
  },
  {
    "id": "seg_0069",
    "start": 146.85,
    "end": 148.32,
    "speaker": "S04",
    "text": "大哥这他妈是惊喜啊"
  },
  {
    "id": "seg_0070",
    "start": 148.72,
    "end": 150.32,
    "speaker": "S04",
    "text": "小弟我愿意等你三天"
  },
  {
    "id": "seg_0071",
    "start": 150.35,
    "end": 150.88,
    "speaker": "S01",
    "text": "好"
  },
  {
    "id": "seg_0072",
    "start": 153.95,
    "end": 154.68,
    "speaker": "S04",
    "text": "黄老爷"
  },
  {
    "id": "seg_0073",
    "start": 155.18,
    "end": 157.75,
    "speaker": "S04",
    "text": "汤师爷是我的挚爱"
  },
  {
    "id": "seg_0074",
    "start": 158.32,
    "end": 160.92,
    "speaker": "S04",
    "text": "你可不能夺我所爱啊"
  },
  {
    "id": "seg_0075",
    "start": 162.08,
    "end": 163.75,
    "speaker": "S01",
    "text": "了然"
  },
  {
    "id": "seg_0076",
    "start": 167.88,
    "end": 168.62,
    "speaker": "S06",
    "text": "到底是谁"
  },
  {
    "id": "seg_0077",
    "start": 168.92,
    "end": 169.45,
    "speaker": "S06",
    "text": "这个"
  },
  {
    "id": "seg_0078",
    "start": 169.92,
    "end": 170.45,
    "speaker": "S06",
    "text": "你这"
  }
]
