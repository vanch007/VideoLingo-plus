# VideoLingo-plus local secrets.
# Copy to .env for local shells if needed. .env is ignored by git.

# Generic OpenAI-compatible LLM provider used by the existing api block.
VIDEOLINGO_API_KEY=
VIDEOLINGO_API_BASE_URL=https://api.siliconflow.cn
VIDEOLINGO_API_MODEL=deepseek-ai/DeepSeek-V3.2

# Optional preset providers from llm.providers.
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
LM_STUDIO_API_KEY=local
OMLX_API_KEY=1234
OMLX_BASE_URL=http://127.0.0.1:8000/v1
OMLX_MODEL=auto

# Hugging Face token, required for WhisperX diarization/private model access.
VIDEOLINGO_HF_TOKEN=

# TTS providers.
VIDEOLINGO_SILICONFLOW_API_KEY=
VIDEOLINGO_OPENAI_API_KEY=
VIDEOLINGO_ELEVENLABS_API_KEY=

# Optional local/cloud services.
CLOUDFLARE_EDGE_TTS_URL=http://127.0.0.1:5566/tts
CLOUDFLARE_EDGE_TTS_RETRIES=1
